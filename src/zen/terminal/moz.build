# Build into dist/bin, the input to every macOS bundle/repack operation.
# This standalone C helper does not link Gecko or load browser libraries.
if CONFIG["OS_ARCH"] == "Darwin":
    Program("zen-terminal-pty")
    SOURCES += ["native/zen-terminal-pty.c"]
