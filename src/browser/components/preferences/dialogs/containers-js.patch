+function readZenTerminalContainerRecipes() {
+  try {
+    const parsed = JSON.parse(
+      Services.prefs.getStringPref(ZEN_TERMINAL_CONTAINER_RECIPES_PREF, "{}")
+    );
+    if (parsed && typeof parsed == "object" && !Array.isArray(parsed)) {
+      return parsed;
+    }
+  } catch (error) {}
+  return {};
+}
+
+function writeZenTerminalContainerRecipes(recipes) {
+  Services.prefs.setStringPref(
+    ZEN_TERMINAL_CONTAINER_RECIPES_PREF,
+    JSON.stringify(recipes || {})
+  );
+}
+
+function normalizeZenTerminalSteps(recipe) {
+  // Legacy recipes such as `cd ~/projects/app && claude` become one step.
+  const legacyCommand =
+    typeof recipe == "string"
+      ? recipe.trim()
+      : typeof recipe?.command == "string"
+        ? recipe.command.trim()
+        : "";
+  const rawSteps =
+    recipe && typeof recipe == "object" && Array.isArray(recipe.steps)
+      ? recipe.steps
+      : [];
+  const usedIds = new Set();
+  let steps = rawSteps
+    .map((step, index) => {
+      const command =
+        typeof step == "string"
+          ? step.trim()
+          : typeof step?.command == "string"
+            ? step.command.trim()
+            : "";
+      if (!command) {
+        return null;
+      }
+
+      const requestedId =
+        typeof step?.id == "string" ? step.id.trim() : "";
+      const baseId = requestedId || `step-${index + 1}`;
+      let id = baseId;
+      let suffix = 2;
+      while (usedIds.has(id)) {
+        id = `${baseId}-${suffix++}`;
+      }
+      usedIds.add(id);
+      return { id, command };
+    })
+    .filter(Boolean);
+
+  if (!steps.length && legacyCommand) {
+    steps = [{ id: "step-1", command: legacyCommand }];
+  }
+  return steps;
+}
+
+function getZenTerminalContainerRecipe(userContextId) {
+  const record = readZenTerminalContainerRecipes()[String(userContextId)];
+  if (record?.kind != "terminal") {
+    return null;
+  }
+
+  return {
+    kind: "terminal",
+    recipe: {
+      type: "ordered-steps",
+      steps: normalizeZenTerminalSteps(record.recipe),
+    },
+  };
+}
+
+function setZenTerminalContainerRecipe(userContextId, steps) {
+  const recipes = readZenTerminalContainerRecipes();
+  const normalizedSteps = normalizeZenTerminalSteps({ steps });
+  recipes[String(userContextId)] = {
+    version: 3,
+    kind: "terminal",
+    recipe: {
+      type: "ordered-steps",
+      // One-step recipes still work in builds that only understand v2.
+      command:
+        normalizedSteps.length == 1 ? normalizedSteps[0].command : "",
+      steps: normalizedSteps,
+    },
+  };
+  writeZenTerminalContainerRecipes(recipes);
+}
+
+function removeZenTerminalContainerRecipe(userContextId) {
+  const recipes = readZenTerminalContainerRecipes();
+  delete recipes[String(userContextId)];
+  writeZenTerminalContainerRecipes(recipes);
+}

